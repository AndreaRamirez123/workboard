{
  "firestore": {
    "database": "default",
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "workboard-cun",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.mjs",
        "headers": [{ "key": "Content-Type", "value": "application/javascript" }]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "storage": {
    "bucket": "desarrollo-investigaciones.firebasestorage.app",
    "rules": "storage.rules"
  }
}
