rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        "andrea_ramirezt@cun.edu.co",
        "angela_bernalm@cun.edu.co",
        "jarvey_gonzalez@cun.edu.co"
      ];
    }

    function isRoleAdmin() {
      return isAdmin() || (
        request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role in ["admin", "superadmin"]
      );
    }

    function isGrupoMember(equipoId) {
      let eq = get(/databases/$(database)/documents/equipos/$(equipoId));
      return request.auth != null &&
        eq.data.get("memberUids", []).hasAny([request.auth.uid]);
    }

    function isGrupoMemberOrAdmin(equipoId) {
      return isRoleAdmin() || isGrupoMember(equipoId);
    }

    // ── Compañeros ──────────────────────────────────────────────
    match /companeros/{docId} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      // Actualizar: admin o el propio usuario (por uid o email)
      allow update: if isAdmin() || (
        request.auth != null && (
          request.auth.uid == resource.data.get("uid", "") ||
          request.auth.token.email == resource.data.get("email", "")
        )
      );

      // Retroalimentación: coordinadores y superadmins escriben; dueño y coordinadores leen
      match /retroalimentacion/{fbId} {
        allow read: if request.auth != null && (
          isRoleAdmin() ||
          request.auth.uid == get(/databases/$(database)/documents/companeros/$(docId)).data.get("uid", "") ||
          request.auth.token.email == get(/databases/$(database)/documents/companeros/$(docId)).data.get("email", "")
        );
        allow create: if isRoleAdmin();
        allow update, delete: if isRoleAdmin();
      }

      // Tareas: coordinadores y superadmins crean/eliminan; dueño y coordinadores actualizan y leen
      match /tareas/{taskId} {
        allow read: if request.auth != null && (
          isRoleAdmin() ||
          request.auth.uid == get(/databases/$(database)/documents/companeros/$(docId)).data.get("uid", "") ||
          request.auth.token.email == get(/databases/$(database)/documents/companeros/$(docId)).data.get("email", "")
        );
        allow create, delete: if isRoleAdmin();
        allow update: if isRoleAdmin() || (
          request.auth != null && (
            request.auth.uid == get(/databases/$(database)/documents/companeros/$(docId)).data.get("uid", "") ||
            request.auth.token.email == get(/databases/$(database)/documents/companeros/$(docId)).data.get("email", "")
          )
        );
      }

      // Documentos adjuntos: cualquier usuario autenticado puede subir y leer;
      // solo admin puede eliminar (para proteger contra borrado malicioso)
      match /documentos/{documentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if isAdmin() || (
          request.auth != null && (
            request.auth.uid == get(/databases/$(database)/documents/companeros/$(docId)).data.get("uid", "") ||
            request.auth.token.email == get(/databases/$(database)/documents/companeros/$(docId)).data.get("email", "")
          )
        );
      }
    }

    // ── Bitácora (logs) ─────────────────────────────────────────
    match /logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() ||
        (request.auth != null && request.auth.uid == resource.data.creadoPor);
    }

    // ── Notificaciones de tareas ────────────────────────────────
    match /notificaciones/{notifId} {
      allow read: if isRoleAdmin();
      allow create: if request.auth != null;
    }

    // ── Notificaciones personales por usuario ───────────────────
    match /notif_usuario/{uid} {
      match /items/{itemId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null;
      }
    }

    // ── Cola de notificaciones WhatsApp ─────────────────────────
    match /wpp_queue/{docId} {
      allow create: if isAdmin();
      allow read, update: if false;
    }

    // ── Roles de usuario ────────────────────────────────────────
    match /usuarios/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow update: if request.auth.uid == uid || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Workspaces de equipo ────────────────────────────────────
    match /semilleros/{semilleroId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // ── Equipos ─────────────────────────────────────────────────
    match /equipos/{equipoId} {
      allow read, write: if request.auth != null;

      match /logs/{logId} {
        allow read: if isGrupoMemberOrAdmin(equipoId);
        allow create: if isGrupoMemberOrAdmin(equipoId);
        allow update, delete: if isAdmin() ||
          (request.auth != null && request.auth.uid == resource.data.creadoPor);
      }

      match /tareas/{taskId} {
        allow read: if isGrupoMemberOrAdmin(equipoId);
        allow create, delete: if isAdmin();
        allow update: if isGrupoMemberOrAdmin(equipoId);
      }

      match /retroalimentacion/{fbId} {
        allow read: if isGrupoMemberOrAdmin(equipoId);
        allow write: if isAdmin();
      }

      match /documentos/{docId} {
        allow read: if isGrupoMemberOrAdmin(equipoId);
        allow create: if isGrupoMemberOrAdmin(equipoId);
        allow delete: if isAdmin();
      }

      match /contactos/{contactId} {
        allow read: if isAdmin();
        allow create, delete: if isAdmin();
      }
    }

  }
}
